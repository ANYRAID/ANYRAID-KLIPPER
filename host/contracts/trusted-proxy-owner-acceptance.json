  "policy": {
    "owner": "Original TrustedClients and NSS policy/cache; no second trust or proxy cache",
    "admission": "Anonymous proxied identity requires actual peer and selected client to match. Headers of unverified peers cannot change login accounting or one-shot bindings. Malformed present claims deny anonymous/proxy binding; original valid credentials retain priority.",
    "intentionalHardeningVsUpstream": "Upstream Tornado applies claims even before the peer is checked and ignores invalid IP claims. Native only lets verified peers affect rate-limit/token addresses and refuses malformed claims for anonymous grants. Explicitly preserved safety behavior; not claimed bit-identical malformed/unverified-proxy compatibility.",
    "snapshot": "Immutable addresses captured once per IncomingMessage; no socket mutation or cross-keepalive leak. Live owner/force-login/credential/expiry policy rechecked after NSS; original request deadline/cancel/capacity retained.",
    "shortToken": "Unresolved peer lookup occurs before token consumption; five-second token lifecycle and original at-most-once removal remain.",
    "closed": "No query may authorize an aborted or closed owner; captured print authority freezes address data and rechecks current policy."
  },
