  "implemented": {
    "journey": [
      "POST/RPC post_directory creates an existing-parent child",
      "GET/RPC get_directory lists immediate children; extended metadata retains full lookup path",
      "Multipart root=gcodes plus optional relative path publishes actual filename with an opaque immutable ID",
      "Metadata, thumbnails, percent-encoded downloads and standard print/start resolve canonical path to original ID",
      "DELETE/RPC delete_file preserves active-job guards; DELETE/RPC delete_directory removes only empty directories",
      "Persistent directories, named receipts and original nested thumbnail URLs recover after process restart"
    ],
    "identity": "Logical visible namespace never becomes a blob/receipt filesystem path. Content, receipt ID and sealed print snapshots remain immutable; opaque ID literals are not alternate names for named files.",
    "legacy": "Explicit file_id with absent path retains ID.gcode and existing v1 receipt schema. Standard multipart or explicit empty path publishes actual filename.",
    "limits": {
      "pathUtf8Bytes": 1024,
      "componentUtf8Bytes": 255,
      "maxComponents": 32,
      "maxDirectories": 1024,
      "maxDirectoryManifestBytes": 2097152,
      "receiptBytes": 2048
    },
    "protection": [
      "Relative POSIX paths; well-formed UTF-16; no dot/dotdot/empty segments, backslash, NUL/control, .thumbs or .git segments",
      "Path collision claims reserved across admitted concurrent publication; directory mutations wait behind publication barrier",
      "Raw/resolved-ID authorization retained; download/delete/start revalidate path binding after authorization",
      "Directory mutations use bounded admission, cancellation and shared maintenance activity; committed events use existing authorized bounded queues",
      "Commit failure reports ApiError 500 data.phase before-replace/replaced through HTTP and RPC; replaced uncertainty requires recovery",
      "Recovery validates all parent/collision/receipt invariants before deleting owned temporary or unreferenced content"
    ]
  },
