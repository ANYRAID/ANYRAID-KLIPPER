  "behaviorChanges": [
    "Signed 9-bit temperature fixes legacy negative-value bias of +256 degrees",
    "Read normal configuration, reject shutdown; skip optional product ID which may NACK",
    "No invented humidity field; fractional report interval defaults to 0.8 seconds with minimum 0.5",
    "Enforce 500 ms quiet time after configuration or temperature read including forced target sampling",
    "Transport errors latch and stop the MCU group; never publish fake zero"
  ],
  "source": "https://www.ti.com/lit/ds/symlink/lm75a.pdf",
  "limitations": [
    "Legacy sensor_type LM75 remains 9-bit / 0.5 degree; no automatic higher-resolution vendor detection",
    "Driver benchmark uses fake IO and virtual waiting; conversion benchmark compares computation only",
    "All product tests use simulated MCU transport; no physical printer or sensor acceptance",
    "Historical runtime motion anomalies unresolved",
    "No Python retired; default print entry remains Python"
  ]
}
