  "scope": "Frozen actual upstream parsing results. Exact unsafe integers tagged; does not prove a general Jinja numeric-type bridge. New default tests do not execute Python.",
  "cases": [
    {
      "name": "json nested",
      "text": "{\"ldap\":{\"base_dn\":\"dc=example,dc=test\",\"password\":\"synthetic-value\"},\"array\":[true,null,1.0]}",
      "type": "json",
      "expected": {
        "ldap": {
          "base_dn": "dc=example,dc=test",
          "password": "synthetic-value"
        },
        "array": [
          true,
          null,
          1.0
        ]
      }
    },
    {
      "name": "empty json",
      "text": "{}",
      "type": "json",
      "expected": {}
    },
    {
      "name": "json duplicate and prototype names",
      "text": "{\"x\":1,\"x\":2,\"__proto__\":{\"constructor\":\"literal\"}}",
      "type": "json",
      "expected": {
        "x": 2,
        "__proto__": {
          "constructor": "literal"
        }
      }
    },
    {
      "name": "exact large integer",
      "text": "{\"x\":9007199254740993,\"negative\":-9007199254740993}",
      "type": "json",
      "expected": {
        "x": {
          "$exactInteger": "9007199254740993"
        },
        "negative": {
          "$exactInteger": "-9007199254740993"
        }
      }
    },
    {
      "name": "json nonobject",
      "text": "[\"synthetic-value\"]",
      "type": "invalid",
      "expected": {}
    },
    {
      "name": "json primitive",
      "text": "42",
      "type": "invalid",
      "expected": {}
    },
    {
      "name": "ini casing defaults and literal comments",
      "text": "[DEFAULT]\nbase = common\n[LDAP]\nPASSWORD=synthetic # literal ; literal\npercent=%(base)s\nurl=ldap://example.test:389\n",
      "type": "ini",
      "expected": {
        "LDAP": {
          "base": "common",
          "password": "synthetic # literal ; literal",
          "percent": "%(base)s",
          "url": "ldap://example.test:389"
        }
      }
    },
    {
      "name": "ini multiline blank and comment",
      "text": "[service]\nvalue=first\n  second\n\n# ignored\n  fourth\nnext=last\n",
      "type": "ini",
      "expected": {
        "service": {
          "value": "first\nsecond\n\nfourth",
          "next": "last"
        }
      }
    },
    {
      "name": "ini no include expansion",
      "text": "[include absent.conf]\nvalue=literal\n",
      "type": "ini",
      "expected": {
        "include absent.conf": {
          "value": "literal"
        }
      }
    },
    {
      "name": "ini default only",
